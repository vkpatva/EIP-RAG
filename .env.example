# Embedding provider credentials.
#
# Copy to .env and fill in the key for whichever provider you use:
#
#   cp .env.example .env
#
# .env is gitignored; this file is the tracked template and must never
# contain a real key.

# Which provider `npm run embed` uses: openai | voyage
EMBEDDING_PROVIDER=openai

# --- OpenAI -----------------------------------------------------------------
# https://platform.openai.com/api-keys
# text-embedding-3-small: 1536 dims, ~$0.02/1M tokens. Symmetric.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Voyage AI --------------------------------------------------------------
# https://dashboard.voyageai.com/api-keys
# voyage-3: 1024 dims. Asymmetric — distinguishes documents from queries.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3

# Changing either model above invalidates every stored vector: each model has
# its own coordinate space, so old and new vectors are not comparable. A model
# change means re-embedding the corpus, not a migration.

# --- Qdrant -----------------------------------------------------------------
# Local instance from docker-compose.yml. Both are optional: the defaults below
# are what the code uses when they are unset, and a local Qdrant needs no key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
